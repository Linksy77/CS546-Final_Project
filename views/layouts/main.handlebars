<!DOCTYPE html>
<html lang="en">
<head>
  <title>{{title}}</title>
  <link rel="stylesheet" href="/public/css/styles.css">
  <link rel="stylesheet" href="/public/css/neighborhoods.css">
</head>
<body>
  <header class="site-header">
    <div class="container">
      <h1>Noise Complaint Detective</h1>
      <p class="tagline">NYC 311 Noise Complaints</p>
    </div>
  </header>

  <nav class="site-nav-bar">
    <div class="nav-container">
      <ul>
        <a id="homelink" class="nav-link" href="/">Home</a>
        <a id="neighborhoods" class="nav-link" href="/neighborhoods">Compare</a>
        <a id="searchlink" class="nav-link" href="/search">Search</a>
        <a id="heatmaplink" class="nav-link" href="/heatmap">Heat Map</a> 
        {{#if user}}
          <a id="userlink" class="nav-link" href="/userProfile">Your Profile</a>
          <a id="signout" class="nav-link" href="/signout">Sign Out</a>
        {{else}}
          <a id="signuplink" class="nav-link" href="/signup">Sign Up</a>
          <a id="loginlink" class="nav-link" href="/login">Log In</a>
        {{/if}}
      </ul>
    </div>
  </nav>

  <h2>{{title}}</h2>

  <main class="container">
    {{{body}}}
  </main>

  <footer class="site-footer">
    <div class="container">
      <small>Data sourced from NYC Open Data (311).</small>
    </div>
  </footer>
  <script src="/public/js/search.js"></script>
</body>
</html>
